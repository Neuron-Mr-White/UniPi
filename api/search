#11-project-name-and-description","content":"Primary interface"},"1225":{"id":"/docs/overview-45","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#11-project-name-and-description","content":"Terminal UI (TUI) inside Pi; one small HTTP-served kanban UI"},"1226":{"id":"/docs/overview-46","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"Unipi extends a single terminal AI coding agent into a fuller development platform. Its capabilities cluster around five functional areas:"},"1227":{"id":"/docs/overview-47","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"Area"},"1228":{"id":"/docs/overview-48","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"What it delivers"},"1229":{"id":"/docs/overview-49","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"Representative packages"},"1230":{"id":"/docs/overview-50","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"**Agent orchestration**"},"1231":{"id":"/docs/overview-51","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"Delegate work to subagents, run background child processes with budgets and tracked state, execute autonomous \"Ralph\" loops"},"1232":{"id":"/docs/overview-52","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"`subagents`, `background-tasks`, `ralph`"},"1233":{"id":"/docs/overview-53","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"**Context & memory management**"},"1234":{"id":"/docs/overview-54","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"Deterministic multi-stage context compaction, SQLite session store with recall on resume, durable memory backed by MemPalace, trajectory capture"},"1235":{"id":"/docs/overview-55","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"`compactor`, `memory`, `trajectory`"},"1236":{"id":"/docs/overview-56","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"**External capability integration**"},"1237":{"id":"/docs/overview-57","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"Bridge MCP servers into Pi tools, web search and smart-fetch extraction, image generation/recognition, model fusion with a sidekick runtime"},"1238":{"id":"/docs/overview-58","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"`mcp`, `web-api`, `image`, `fusion`"},"1239":{"id":"/docs/overview-59","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"**User interaction & presentation**"},"1240":{"id":"/docs/overview-60","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"Responsive footer status bar, interactive `ask_user` prompts and session handoff, keyboard chords with undo/redo, info screen, autocomplete, quick side questions, outbound notifications"},"1241":{"id":"/docs/overview-61","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"`footer`, `ask-user`, `input-shortcuts`, `notify`, `info-screen`, `autocomplete`, `btw`"},"1242":{"id":"/docs/overview-62","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"**Structured development workflow**"},"1243":{"id":"/docs/overview-63","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"Workflow commands with sandboxes, milestone tracking, a kanban board rendered from plan/milestone markdown"},"1244":{"id":"/docs/overview-64","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"`workflow`, `milestone`, `kanboard`"},"1245":{"id":"/docs/overview-65","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#12-core-functionality-and-business-value","content":"**Business value in one sentence:** developers get longer autonomous agent sessions (less context-window pressure), parallel and long-running task execution, memory that survives across sessions, and access to external tools and data — all without leaving one CLI."},"1246":{"id":"/docs/overview-66","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#13-technical-characteristics","content":"**Plugin-style, event-driven architecture.** A thin shared kernel (`@pi-unipi/core`) supplies constants, an inter-module event bus (`MODULE_READY` discovery and feature events), sandbox primitives and TUI helpers. Every other package depends on core but remains independently loadable and config-gated."},"1247":{"id":"/docs/overview-67","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#13-technical-characteristics","content":"**Loose cross-package coupling.** Packages communicate primarily through core events and footer segments rather than direct imports; the notable exception is `kanboard` importing `milestone` types."},"1248":{"id":"/docs/overview-68","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#13-technical-characteristics","content":"**Process-oriented delegation.** Subagents and MCP servers run as OS child processes; Unipi tails their output, tracks usage, and can terminate whole process trees (including Windows `taskkill`)."},"1249":{"id":"/docs/overview-69","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#13-technical-characteristics","content":"**File- and SQLite-based persistence** with crash-safe atomic writes for task artifacts, session events and compaction statistics."},"1250":{"id":"/docs/overview-70","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#13-technical-characteristics","content":"**Deterministic compaction pipeline.** A six-stage `compile()` pipeline (normalize → filterNoise → buildSections → formatSummary → merge → ranked brief) produces structured summaries rather than relying solely on model-generated summaries."},"1251":{"id":"/docs/overview-71","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#21-user-roles","content":"Role"},"1252":{"id":"/docs/overview-72","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#21-user-roles","content":"Description"},"1253":{"id":"/docs/overview-73","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#21-user-roles","content":"Primary needs"},"1254":{"id":"/docs/overview-74","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#21-user-roles","content":"**AI coding agent users**"},"1255":{"id":"/docs/overview-75","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#21-user-roles","content":"Developers who run the Pi coding agent in a terminal and install Unipi extensions."},"1256":{"id":"/docs/overview-76","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#21-user-roles","content":"Longer sessions without hitting context limits; parallel and background task execution; persistent memory across sessions; access to external tools and data via MCP."},"1257":{"id":"/docs/overview-77","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#21-user-roles","content":"**Extension developers**"},"1258":{"id":"/docs/overview-78","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#21-user-roles","content":"Engineers building or maintaining packages inside the Unipi monorepo."},"1259":{"id":"/docs/overview-79","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#21-user-roles","content":"Clear package boundaries and shared core contracts; consistent registration with the Pi extension API; reusable TUI and tooling primitives."},"1260":{"id":"/docs/overview-80","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#21-user-roles","content":"**Teams using structured workflows**"},"1261":{"id":"/docs/overview-81","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#21-user-roles","content":"Groups that adopt the workflow, kanboard and milestone packages to manage disciplined development."},"1262":{"id":"/docs/overview-82","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#21-user-roles","content":"Workflow commands and sandboxes; kanban document parsing and a board UI; milestone and trajectory tracking."},"1263":{"id":"/docs/overview-83","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#22-usage-scenarios","content":"Scenario"},"1264":{"id":"/docs/overview-84","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#22-usage-scenarios","content":"Actor"},"1265":{"id":"/docs/overview-85","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#22-usage-scenarios","content":"Unipi behaviour"},"1266":{"id":"/docs/overview-86","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#22-usage-scenarios","content":"Delegating a sub-task"},"1267":{"id":"/docs/overview-87","page_id":"/docs/overview","tags":[],"type":"text","url":"/docs/overview#22-usage-scenarios","conte