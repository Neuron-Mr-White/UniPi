y-integration-domain-18","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#52-conditional-registration-and-vision-gating","content":"5.2 Conditional Registration and Vision Gating"},"2414":{"id":"/docs/deep-exploration/external-capability-integration-domain-19","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#53-provider-bridging-for-generation","content":"5.3 Provider Bridging for Generation"},"2415":{"id":"/docs/deep-exploration/external-capability-integration-domain-20","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#54-image_generate","content":"5.4 `image_generate`"},"2416":{"id":"/docs/deep-exploration/external-capability-integration-domain-21","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#55-image_recognize","content":"5.5 `image_recognize`"},"2417":{"id":"/docs/deep-exploration/external-capability-integration-domain-22","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#6-model-fusion--sidekick-pi-unipifusion","content":"6\\. Model Fusion & Sidekick (`@pi-unipi/fusion`)"},"2418":{"id":"/docs/deep-exploration/external-capability-integration-domain-23","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#61-responsibilities","content":"6.1 Responsibilities"},"2419":{"id":"/docs/deep-exploration/external-capability-integration-domain-24","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#62-layered-preset-presetts","content":"6.2 Layered Preset (`preset.ts`)"},"2420":{"id":"/docs/deep-exploration/external-capability-integration-domain-25","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#63-commands-and-picker-flow","content":"6.3 Commands and Picker Flow"},"2421":{"id":"/docs/deep-exploration/external-capability-integration-domain-26","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#64-sidekickruntime","content":"6.4 `SidekickRuntime`"},"2422":{"id":"/docs/deep-exploration/external-capability-integration-domain-27","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#65-tools-and-lead-policy","content":"6.5 Tools and Lead Policy"},"2423":{"id":"/docs/deep-exploration/external-capability-integration-domain-28","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#66-savings-and-status-publication","content":"6.6 Savings and Status Publication"},"2424":{"id":"/docs/deep-exploration/external-capability-integration-domain-29","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#7-cross-cutting-integration-contracts","content":"7\\. Cross-Cutting Integration Contracts"},"2425":{"id":"/docs/deep-exploration/external-capability-integration-domain-30","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#71-event-bus","content":"7.1 Event Bus"},"2426":{"id":"/docs/deep-exploration/external-capability-integration-domain-31","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#72-shared-global-state","content":"7.2 Shared Global State"},"2427":{"id":"/docs/deep-exploration/external-capability-integration-domain-32","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#73-on-disk-state","content":"7.3 On-Disk State"},"2428":{"id":"/docs/deep-exploration/external-capability-integration-domain-33","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#74-host-api-adaptation","content":"7.4 Host API Adaptation"},"2429":{"id":"/docs/deep-exploration/external-capability-integration-domain-34","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#8-observations-and-recommendations","content":"8\\. Observations and Recommendations"},"2430":{"id":"/docs/deep-exploration/external-capability-integration-domain-35","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain","content":"**Project:** Unipi — extension suite for the Pi coding agent\n&#x2A;*Packages:** `@pi-unipi/mcp`, `@pi-unipi/web-api`, `@pi-unipi/image`, `@pi-unipi/fusion`\n&#x2A;*Document date:** 2026-09-16"},"2431":{"id":"/docs/deep-exploration/external-capability-integration-domain-36","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"The External Capability Integration Domain is the part of Unipi that extends the agent's reach beyond the terminal and beyond the host's built-in tool set. Where the Agent Orchestration domain multiplies *agents* and the Context & Memory domain stretches *context*, this domain multiplies *capabilities*: it lets the model call tools served by third-party Model Context Protocol (MCP) servers, search and read the web, generate and interpret images, and pair a primary \"lead\" model with a cheaper \"sidekick\" model for delegated work."},"2432":{"id":"/docs/deep-exploration/external-capability-integration-domain-37","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"The domain is implemented as four independent Pi extension packages. Each follows the same architectural shape that the rest of Unipi uses:"},"2433":{"id":"/docs/deep-exploration/external-capability-integration-domain-38","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"Package"},"2434":{"id":"/docs/deep-exploration/external-capability-integration-domain-39","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"Sub-module"},"2435":{"id":"/docs/deep-exploration/external-capability-integration-domain-40","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"Primary responsibility"},"2436":{"id":"/docs/deep-exploration/external-capability-integration-domain-41","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"`@pi-unipi/mcp`"},"2437":{"id":"/docs/deep-exploration/external-capability-integration-domain-42","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"MCP Server Bridge"},"2438":{"id":"/docs/deep-exploration/external-capability-integration-domain-43","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"Spawn MCP servers, translate their tools into Pi tools, proxy calls back over JSON-RPC/stdio"},"2439":{"id":"/docs/deep-exploration/external-capability-integration-domain-44","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"`@pi-unipi/web-api`"},"2440":{"id":"/docs/deep-exploration/external-capability-integration-domain-45","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"Web Search & Smart-Fetch Engine"},"2441":{"id":"/docs/deep-exploration/external-capability-integration-domain-46","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"Provider-ranked web search/read/summarize plus a local extraction pipeline"},"2442":{"id":"/docs/deep-exploration/external-capability-integration-domain-47","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"`@pi-unipi/image`"},"2443":{"id":"/docs/deep-exploration/external-capability-integration-domain-48","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"Image Generation & Recognition"},"2444":{"id":"/docs/deep-exploration/external-capability-integration-domain-49","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"`image_generate` / `image_recognize` tools bridging Pi providers into image APIs"},"2445":{"id":"/docs/deep-exploration/external-capability-integration-domain-50","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"`@pi-unipi/fusion`"},"2446":{"id":"/docs/deep-exploration/external-capability-integration-domain-51","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"Model Fusion & Sidekick"},"2447":{"id":"/docs/deep-exploration/external-capability-integration-domain-52","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"`/unipi:model` picker, layered presets, a persistent sidekick child process"},"2448":{"id":"/docs/deep-exploration/external-capability-integration-domain-53","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"All four depend on `@pi-unipi/core` for constants (`MCP_DEFAULTS`, `IMAGE_TOOLS`, `MODULES`, …), the typed event contract (`UNIPI_EVENTS`, `emitEvent`), bounded-output helpers and — in the fusion case — the shared `fusion-status` slot. `@pi-unipi/fusion` additionally depends on `@pi-unipi/subagents` for `getPiSpawnCommand`, the one intra-domain cross-package import worth noting."},"2449":{"id":"/docs/deep-exploration/external-capability-integration-domain-54","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#2-domain-architecture","content":"Three characteristics are shared across the four packages and define the domain's style:"},"2450":{"id":"/docs/deep-exploration/external-capability-integration-domain-55","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#2-domain-architecture","content":"**Adapter pattern at the boundary.** Every external system is wrapped by a small adapter with an injected or feature-detected surface — `ServerRegistryOptions` injects `emitEvent`/`registerTool`/`unregisterTool`/`createClient`; `SidekickSpawnConfig` accepts an injectable `spawn` and `command`; `RecognizeOptions` and `ImagesOptionsLike` accept `fetchImpl`. This keeps the bridges testable without live servers or network access."},"2451":{"id":"/docs/deep-exploration/external-capability-integration-domain-56","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#2-domain-architecture","content":"**Fail-soft integration.** A failed MCP server, a missing `pi-ai` images collection, an unavailable wigolo daemon or an unreachable lead model all degrade into a status entry, a `\"?\"` in the info screen, or a notice — never a crash of the host."},"2452":{"id":"/docs/deep-exploration/external-capability-integration-domain-57","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#2-domain-architecture","content":"**Context budget awareness.** MCP results pass through `boundModelOutput` (64 KB cap with artifact spill-over), web content is truncated to `maxChars` (default 50 000), vision replies are capped at 2 048 tokens, and sidekick tool output is trimmed to 4 000 characters."},"2453":{"id":"/docs/deep-exploration/external-capability-integration-domain-58","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#31-responsibilities","content":"The MCP bridge turns any stdio-based MCP server into a set of ordinary Pi tools. It owns four concerns: configuration (load, validate, merge, sync a catalog), lifecycle (spawn, handshake, stop, restart), translation (MCP schema → Pi tool definition) and proxying (Pi tool call → `tools/call` JSON-RPC request)."},"2454":{"id":"/docs/deep-exploration/external-capability-integration-domain-59","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#32-configuration-layer","content":"`config/manager.ts` reads two files per scope:"},"2455":{"id":"/docs/deep-exploration/external-capability-integration-domain-60","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#32-configuration-layer","content":"File"},"2456":{"id":"/docs/deep-exploration/external-capability-integration-domain-61","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#32-configuration-layer","content":"Content"},"2457":{"id":"/docs/deep-exploration/external-capability-integration-domain-62","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#32-configuration-layer","content":"Scopes"},"2458":{"id":"/docs/deep-exploration/external-capability-integration-domain-63","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#32-configuration-layer","content":"`mcp-config.json`"},"2459":{"id":"/docs/deep-exploration/external-capability-integration-domain-64","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#32-configuration-layer","content":"`{ mcpServers: { name: { command, args, env? } } }` — Claude Desktop / Cursor compatible"},"2460":{"id":"/docs/deep-exploration/external-capability-integration-domain-65","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#32-configuration-layer","content":"`~/.unipi/config/mcp/` (global), `<cwd>/.unipi/config/mcp/` (project)"},"2461":{"id":"/docs/deep-exploration/external-capability-integration-domain-66","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#32-configuration-layer","content":"`config.json`"},"2462":{"id":"/docs/deep-exploration/external-capability-integration-domain-67","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#32-configuration-layer","content":"Per-server metadata (`enabled`, `addedAt`) and sync settings (`enabled`, `lastSyncAt`, `syncIntervalMs`)"},"2463":{"id":"/docs/deep-exploration/external-capability-integration-domain-68","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#32-configuration-layer","content":"same two scopes"},"2464":{"id":"/docs/deep-exploration/external-capability-integration-domain-69","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#32-configuration-layer","content":"`validateMcpConfig` (in `config/schema.ts`) enforces that each server has a non-empty string `command`, an array of string `args`, and — if present — a string-valued `env` object. `loadMcpConfig` throws on invalid content, so a corrupt file surfaces as an explicit error rather than a half-loaded server list. `saveMcpConfig` writes with `chmod 600` because the file may contain API keys in `env`."},"2465":{"id":"/docs/deep-exploration/external-capability-integration-domain-70","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#32-configuration-layer","content":"`resolveServers` merges the two scopes into `ResolvedServer[]` with a `ServerSource` tag:"},"2466":{"id":"/docs/deep-exploration/external-capability-integration-domain-71","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#32-configuration-layer","content":"server only in global → `\"global\"`"},"2467":{"id":"/docs/deep-exploration/external-capability-integration-domain-72","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#32-configuration-layer","content":"server only in project → `\"project\"`"},"2468":{"id":"/docs/deep-exploration/external-capability-integration-domain-73","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#32-configuration-layer","content":"server in both → project definition wins entirely → `\"project-override\"`"},"2469":{"id":"/docs/deep-exploration/external-capability-integration-domain-74","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#32-configuration-layer","content":"project metadata `enabled: false` disables a server even if globally defined"},"2470":{"id":"/docs/deep-exploration/external-capability-integration-domain-75","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#32-configuration-layer","content":"`config/sync.ts` fetches the `punkpeye/awesome-mcp-servers` README from GitHub, parses `## Category` headings and `- [Name](url) ⭐ - Description` bullets into `CatalogEntry` records (deduplicated by URL, official flag from the star, scope guessed as `local`/`cloud` via keyword heuristics, language guessed heuristically), enriches known servers with install recipes from `KNOWN_INSTALLS`, caches the result to `~/.unipi/config/mcp/servers.json`, and records `lastSyncAt`. The default sync interval is 24 hours (`DEFAULT_SYNC_CONFIG.syncIntervalMs = 86400000`). If the fetch fails, the bundled `data/seed-servers.json` provides a fallback catalog."},"2471":{"id":"/docs/deep-exploration/external-capability-integration-domain-76","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#33-transport-mcpclient","content":"`bridge/client.ts` implements a minimal JSON-RPC 2.0 client over a child process's stdio:"},"2472":{"id":"/docs/deep-exploration/external-capability-integration-domain-77","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#33-transport-mcpclient","content":"**`connect(command, args, env)`** spawns the process with `stdio: [\"pipe\",\"pipe\",\"pipe\"]` and `{...process.env, ...env}`, then sends `initialize` with `protocolVersion: \"2024-11-05\"` and `clientInfo: { name: \"@pi-unipi/mcp\" }`. On success it sends the `notifications/initialized` notification and marks the client connected. If the process exits before the handshake completes, the rejection message includes a stderr tail (bounded to 10 000 characters, trimmed to the last 5 000 when exceeded)."},"2473":{"id":"/docs/deep-exploration/external-capability-integration-domain-78","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#33-transport-mcpclient","content":"**Framing** is newline-delimited JSON. `handleStdoutData` appends chunks to a buffer, splits on `\\n`, parses each complete line and dispatches responses by `id` to a `Map<number, PendingRequest>`. Notifications from the server are currently ignored; malformed lines are skipped."},"2474":{"id":"/docs/deep-exploration/external-capability-integration-domain-79","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#33-transport-mcpclient","content":"**Timeouts** are per request (`MCP_DEFAULTS.STARTUP_TIMEOUT_MS = 10000` by default). On unexpected process exit after connection, `rejectAllPending` fails every in-flight request."},"2475":{"id":"/docs/deep-exploration/external-capability-integration-domain-80","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#33-transport-mcpclient","content":"**`listTools()`** → `tools/list&#x60;; &#x2A;*`callTool(name, args)`** → `tools/call`."},"2476":{"id":"/docs/deep-exploration/external-capability-integration-domain-81","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#33-transport-mcpclient","content":"**`disconnect()`** sends a `shutdown` notification, sends `SIGTERM`, waits up to 500 ms for exit, then `SIGKILL`s if needed and clears handles."},"2477":{"id":"/docs/deep-exploration/external-capability-integration-domain-82","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#34-lifecycle-serverregistry","content":"`bridge/registry.ts` is the domain's most carefully engineered component. Its central method, `startServers(resolvedServers)`, implements a **discovery barrier**:"},"2478":{"id":"/docs/deep-exploration/external-capability-integration-domain-83","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#34-lifecycle-serverregistry","content":"Key design decisions visible in the code:"},"2479":{"id":"/docs/deep-exploration/external-capability-integration-domain-84","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#34-lifecycle-serverregistry","content":"**Parallel prepare, serial register.** Connections and `tools/list` run concurrently for speed, but Pi-side registration happens only after every server has settled, in deterministic `compareCodeUnits` order. This makes the tool list stable across runs, which matters for prompt-cache stability."},"2480":{"id":"/docs/deep-exploration/external-capability-integration-domain-85","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#34-lifecycle-serverregistry","content":"**No half-registered state.** If any tool name collides, or if any `registerTool` call throws while unregistration is supported, all tools registered in that batch are rolled back and every prepared client is disconnected."},"2481":{"id":"/docs/deep-exploration/external-capability-integration-domain-86","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#34-lifecycle-serverregistry","content":"**Honesty on older hosts.** When the host cannot unregister tools (`canUnregisterTools === false`, detected in `index.ts`), a partial registration failure is *not* pretended away; the affected entries are marked `error` with the message \"some MCP tools remain registered until Pi restarts\", and `stopServer` refuses to run for entries that have tools."},"2482":{"id":"/docs/deep-exploration/external-capability-integration-domain-87","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#34-lifecycle-serverregistry","content":"**Individual failures are isolated.** A server that fails during `prepareServer` gets a `status: \"error\"` entry and emits `MCP_SERVER_ERROR`, but does not prevent other servers' tools from being registered."},"2483":{"id":"/docs/deep-exploration/external-capability-integration-domain-88","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#34-lifecycle-serverregistry","content":"**Locale independence.** `compareCodeUnits` compares UTF-16 code units rather than using `localeCompare`, so ordering is identical on every machine."},"2484":{"id":"/docs/deep-exploration/external-capability-integration-domain-89","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#34-lifecycle-serverregistry","content":"The registry also exposes `stopServer`, `restartServer` (stop then start with the previously resolved definition), `stopAll`, `disconnectAll` (used at shutdown; disconnects clients without claiming tool removal, because Pi tears down the extension's tool set itself), and read accessors `getAll`, `getActive`, `getFailed`, `getTotalToolCount`, `getServerState`, `getEntry`, `hasServer`."},"2485":{"id":"/docs/deep-exploration/external-capability-integration-domain-90","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#35-translation-translatemcptool","content":"`bridge/translator.ts` maps an `McpTool` to a `PiExternalTool`:"},"2486":{"id":"/docs/deep-exploration/external-capability-integration-domain-91","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#35-translation-translatemcptool","content":"**Name** is `${serverName}__${toolName}` (`MCP_DEFAULTS.TOOL_NAME_SEPARATOR = \"__\"`), e.g. `github__search_issues`. The server name in the description (`[Server: github]`) lets the model see the provenance."},"2487":{"id":"/docs/deep-exploration/external-capability-integration-domain-92","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#35-translation-translatemcptool","content":"**Parameters** keep the Pi-facing top-level shape `{ type: \"object\", properties, required }` and are run through `canonicalizeJsonSchema`, which sorts object keys by code units and sorts/deduplicates valid string-only `required` arrays. Values under literal-data keywords (`const`, `default`, `enum`, `examples`) are not normalized, since a property named `required` inside application data must keep its order. The result is a byte-stable schema across restarts."},"2488":{"id":"/docs/deep-exploration/external-capability-integration-domain-93","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#35-translation-translatemcptool","content":"**Execution** calls `client.callTool(mcpTool.name, params)`, then normalizes `McpToolResult.content` blocks: text is passed through, images become `[Image: <mime>]`, resources become `[Resource: …]`. Empty results become `(no output)` or `Unknown error`. The joined text is bounded by `boundModelOutput` to `MCP_DEFAULTS.MAX_MODEL_OUTPUT_BYTES` (64 KB) minus the error wrapper, with overflow written to an artifact whose prefix is `mcp-<server>-<tool>`. Transport failures return a text error that points the user at `/unipi:mcp-settings` rather than throwing into the agent loop."},"2489":{"id":"/docs/deep-exploration/external-capability-integration-domain-94","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#36-extension-entry-and-commands","content":"`src/index.ts` wires everything on `session_start`:"},"2490":{"id":"/docs/deep-exploration/external-capability-integration-domain-95","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#36-extension-entry-and-commands","content":"Feature-detects `registerTool` vs `registerExternalTool` and `unregisterTool` vs `unregisterExternalTool` on the host API and builds the callbacks passed to `ServerRegistry`."},"2491":{"id":"/docs/deep-exploration/external-capability-integration-domain-96","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#36-extension-entry-and-commands","content":"`loadAndResolve(cwd)` and `startServers(enabled servers)`; both are wrapped so failures only appear in registry state."},"2492":{"id":"/docs/deep-exploration/external-capability-integration-domain-97","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#36-extension-entry-and-commands","content":"Registers an info-screen group (`id: \"mcp\"`, priority 15) with total/active/tools/failed counters, read from the global `__unipi_info_registry`."},"2493":{"id":"/docs/deep-exploration/external-capability-integration-domain-98","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#36-extension-entry-and-commands","content":"Emits `MODULE_READY` with the command list and the sorted names of all registered tools — this is how `notify`, `footer` and subagents discover the MCP tool set."},"2494":{"id":"/docs/deep-exploration/external-capability-integration-domain-99","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#36-extension-entry-and-commands","content":"On `session_shutdown` it calls `disconnectAll()` and drops the registry."},"2495":{"id":"/docs/deep-exploration/external-capability-integration-domain-100","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#36-extension-entry-and-commands","content":"Command"},"2496":{"id":"/docs/deep-exploration/external-capability-integration-domain-101","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#36-extension-entry-and-commands","content":"Behaviour"},"2497":{"id":"/docs/deep-exploration/external-capability-integration-domain-102","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#36-extension-entry-and-commands","content":"`/unipi:mcp-status`"},"2498":{"id":"/docs/deep-exploration/external-capability-integration-domain-103","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#36-extension-entry-and-commands","content":"Text summary with `●`/`✗`/`◐`/`○` icons per status, tool counts and error messages"},"2499":{"id":"/docs/deep-exploration/external-capability-integration-domain-104","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#36-extension-entry-and-commands","content":"`/unipi:mcp-sync`"},"2500":{"id":"/docs/deep-exploration/external-capability-integration-domain-105","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#36-extension-entry-and-commands","content":"Forces `syncCatalog()`; emits `MCP_CATALOG_SYNCED`"},"2501":{"id":"/docs/deep-exploration/external-capability-integration-domain-106","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#36-extension-entry-and-commands","content":"`/unipi:mcp-add`"},"2502":{"id":"/docs/deep-exploration/external-capability-integration-domain-107","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#36-extension-entry-and-commands","content":"Opens the catalog browser / custom JSON editor overlay (`tui/add-overlay.ts`, 90% width); saved servers activate after restart"},"2503":{"id":"/docs/deep-exploration/external-capability-integration-domain-108","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#36-extension-entry-and-commands","content":"`/unipi:mcp-settings`"},"2504":{"id":"/docs/deep-exploration/external-capability-integration-domain-109","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#36-extension-entry-and-commands","content":"Opens the server settings overlay (`tui/settings-overlay.ts`) with enable/disable/edit/delete/scope actions, given the live registry"},"2505":{"id":"/docs/deep-exploration/external-capability-integration-domain-110","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#36-extension-entry-and-commands","content":"`/unipi:mcp-reload`"},"2506":{"id":"/docs/deep-exploration/external-capability-integration-domain-111","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#36-extension-entry-and-commands","content":"Intentionally advisory only: explains that a Pi restart is required for a clean tool-schema cache epoch on hosts without dynamic tool removal"},"2507":{"id":"/docs/deep-exploration/external-capability-integration-domain-112","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#41-responsibilities","content":"The web package gives the agent three tools and two backends: a **provider registry** of external search/read/summarize services, and a **local smart-fetch engine** that fetches and extracts page content without any API key."},"2508":{"id":"/docs/deep-exploration/external-capability-integration-domain-113","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#42-provider-registry-and-ranking","content":"`providers/base.ts` defines the `WebProvider` contract: `id`, `name`, `capabilities: (\"search\"|\"read\"|\"summarize\")[]`, `requiresApiKey`, `apiKeyEnv`, a `ranking` object with one integer per capability (0 = unsupported, lower = cheaper/simpler), and optional `search`, `read`, `summarize` methods. `providers/registry.ts` is a singleton `ProviderRegistry` whose `getRankedProviders(capability)` filters to rank > 0 and sorts ascending."},"2509":{"id":"/docs/deep-exploration/external-capability-integration-domain-114","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#42-provider-registry-and-ranking","content":"Providers self-register on import in `index.ts`: wigolo, DuckDuckGo, Jina Search, Jina Reader, SerpAPI, Tavily, Firecrawl and Perplexity. The tool descriptions expose the ranks to the model:"},"2510":{"id":"/docs/deep-exploration/external-capability-integration-domain-115","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#42-provider-registry-and-ranking","content":"Capability"},"2511":{"id":"/docs/deep-exploration/external-capability-integration-domain-116","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#42-provider-registry-and-ranking","content":"Rank → Provider"},"2512":{"id":"/docs/deep-exploration/external-capability-integration-domain-117","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#42-provider-registry-and-ranking","content":"search"},"2513":{"id":"/docs/deep-exploration/external-capability-integration-domain-118","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#42-provider-registry-and-ranking","content":"1 wigolo · 2 DuckDuckGo · 3 Jina Search · 4 SerpAPI · 5 Tavily · 6 Perplexity"},"2514":{"id":"/docs/deep-exploration/external-capability-integration-domain-119","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#42-provider-registry-and-ranking","content":"read"},"2515":{"id":"/docs/deep-exploration/external-capability-integration-domain-120","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#42-provider-registry-and-ranking","content":"0 smart-fetch engine (default, not a registered provider) · 1 wigolo · 2 Jina Reader · 3 Firecrawl · 4 Perplexity"},"2516":{"id":"/docs/deep-exploration/external-capability-integration-domain-121","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#42-provider-registry-and-ranking","content":"summarize"},"2517":{"id":"/docs/deep-exploration/external-capability-integration-domain-122","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#42-provider-registry-and-ranking","content":"1 Perplexity · 2 LLM summarize"},"2518":{"id":"/docs/deep-exploration/external-capability-integration-domain-123","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#42-provider-registry-and-ranking","content":"`tools.ts` adds two selection helpers:"},"2519":{"id":"/docs/deep-exploration/external-capability-integration-domain-124","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#42-provider-registry-and-ranking","content":"**`selectProviderChain(capability, sourceRank?)`** filters ranked providers by `isProviderEnabled` and API-key availability. With an explicit `sourceRank` it returns exactly that provider (user intent is respected; a failure is reported, not silently rerouted). Without one it returns the full ordered list."},"2520":{"id":"/docs/deep-exploration/external-capability-integration-domain-125","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#42-provider-registry-and-ranking","content":"**`withProviderFallthrough(providers, attempt)`** tries each candidate in turn and, if all fail, throws a combined error listing every hop. The code comment explains the motivation: wigolo, the rank-1 provider, is a local engine that requires `npx wigolo init`, so an enabled-but-uninitialized wigolo must not break every web call."},"2521":{"id":"/docs/deep-exploration/external-capability-integration-domain-126","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#43-smart-fetch-extraction-pipeline","content":"`engine/extract.ts` exports `defuddleFetch(url, options)`:"},"2522":{"id":"/docs/deep-exploration/external-capability-integration-domain-127","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#43-smart-fetch-extraction-pipeline","content":"Notable details:"},"2523":{"id":"/docs/deep-exploration/external-capability-integration-domain-128","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#43-smart-fetch-extraction-pipeline","content":"**TLS fingerprinting.** `profiles.ts` lists known Chrome, Firefox, Safari and Edge profiles plus OS values; `resolveBrowserProfile(\"chrome\")` prefix-matches to the newest Chrome (`chrome_145` is the default) and unknown values pass through so newer `wreq-js` profiles remain usable."},"2524":{"id":"/docs/deep-exploration/external-capability-integration-domain-129","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#43-smart-fetch-extraction-pipeline","content":"**Typed errors.** `createError` produces a real `Error` instance that also carries `FetchError` fields (`code`, `phase`, `retryable`, `statusCode`, …), so boundary `catch` blocks show a message instead of `[object Object]`. Wreq errors are classified into `timeout`, `network_error` or `unexpected_response` using `describeError`."},"2525":{"id":"/docs/deep-exploration/external-capability-integration-domain-130","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#43-smart-fetch-extraction-pipeline","content":"**Defaults** (`engine/constants.ts`): `maxChars = 50000`, `timeoutMs = 15000`, `batchConcurrency = 8`, `includeReplies = \"extractors\"`, `format = \"markdown\"`."},"2526":{"id":"/docs/deep-exploration/external-capability-integration-domain-131","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#43-smart-fetch-extraction-pipeline","content":"**Batch mode.** `defuddleFetchMultiple` runs a bounded worker pool (`batchConcurrency` workers pulling from a shared index), records `{status: \"done\", result}` or `{status: \"error\", error}` per position, and returns `{ total, succeeded, failed, items }`."},"2527":{"id":"/docs/deep-exploration/external-capability-integration-domain-132","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#44-caching","content":"`cache.ts` implements `WebCache` under `~/.unipi/config/web-api/cache/`. Keys are `sha256(provider + \":\" + url)`, entries are JSON files carrying `timestamp` and `ttlMs` (default one hour). `get` deletes expired entries lazily; `clearExpired` runs on `session_start` and `session_shutdown`; `clear` backs `/unipi:web-cache-clear`; `getStats` feeds the info-screen group. Smart-fetch results are cached under the `\"smart-fetch\"` provider name with a key that includes `browser`, `format` and `maxChars` so different rendering options do not collide."},"2528":{"id":"/docs/deep-exploration/external-capability-integration-domain-133","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#45-tools","content":"Tool"},"2529":{"id":"/docs/deep-exploration/external-capability-integration-domain-134","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#45-tools","content":"Parameters"},"2530":{"id":"/docs/deep-exploration/external-capability-integration-domain-135","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#45-tools","content":"Behaviour"},"2531":{"id":"/docs/deep-exploration/external-capability-integration-domain-136","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#45-tools","content":"`web_search`"},"2532":{"id":"/docs/deep-exploration/external-capability-integration-domain-137","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#45-tools","content":"`query`, `source? (1–6)`"},"2533":{"id":"/docs/deep-exploration/external-capability-integration-domain-138","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#45-tools","content":"`executeSearch` through the provider chain; formats numbered title/url/snippet results"},"2534":{"id":"/docs/deep-exploration/external-capability-integration-domain-139","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#45-tools","content":"`multi_web_content_read`"},"2535":{"id":"/docs/deep-exploration/external-capability-integration-domain-140","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#45-tools","content":"`url` (string or string\\[]), `source? (0–4)`, `browser`, `os`, `format`, `maxChars`, `timeoutMs`, `removeImages`, `includeReplies`, `proxy`, `batchConcurrency`, `verbose`"},"2536":{"id":"/docs/deep-exploration/external-capability-integration-domain-141","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#45-tools","content":"`source 0` → smart-fetch (cached, single or batch); `source ≥ 1` → provider read (batch handled as per-URL `Promise.all` with individual error capture)"},"2537":{"id":"/docs/deep-exploration/external-capability-integration-domain-142","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#45-tools","content":"`web_llm_summarize`"},"2538":{"id":"/docs/deep-exploration/external-capability-integration-domain-143","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#45-tools","content":"`url`, `prompt?`, `source? (1–2)`"},"2539":{"id":"/docs/deep-exploration/external-capability-integration-domain-144","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#45-tools","content":"`executeSummarize` through the summarize chain; explicitly described as higher cost"},"2540":{"id":"/docs/deep-exploration/external-capability-integration-domain-145","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#45-tools","content":"All three return `isError: true` with a descriptive message on failure rather than throwing. `index.ts` emits `MODULE_READY` with the tool and command names and registers an info group (priority 50) showing enabled providers, wigolo installation state (probed only when enabled, to avoid daemon start-up cost), smart-fetch dependency availability and cache statistics. On shutdown it stops the wigolo daemon if this session started it."},"2541":{"id":"/docs/deep-exploration/external-capability-integration-domain-146","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#51-responsibilities","content":"The image package exposes two agent tools and one command (`/unipi:image-settings`), and solves two integration problems: pi-ai ships only one image provider out of the box, and Pi's model registry cannot say which models emit images or accept them."},"2542":{"id":"/docs/deep-exploration/external-capability-integration-domain-147","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#52-conditional-registration-and-vision-gating","content":"`tools.ts#registerImageTools` registers `image_generate` only when `config.generate.enabled` and `image_recognize` only when `config.recognize.enabled`, so a disabled tool never consumes system-prompt context."},"2543":{"id":"/docs/deep-exploration/external-capability-integration-domain-148","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#52-conditional-registration-and-vision-gating","content":"`index.ts` adds a second, dynamic layer for recognition. `applyVisionGating(pi, model)` calls `applyRecognizeGating(activeTools, model, \"image_recognize\")` from `models.ts`: if the session model is vision-capable (`isVisionModel`, based on the model's declared `input` modalities; undeclared counts as non-vision), the tool is removed from the active set because the model can already read images; if a text-only model takes over, the tool is restored. This runs at `session_start` and on every `model_select` event. The `MODULE_READY` payload lists only the tools that are actually provided after gating."},"2544":{"id":"/docs/deep-exploration/external-capability-integration-domain-149","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#53-provider-bridging-for-generation","content":"`register-providers.ts#registerRegistryImageProviders` re-registers Pi's configured chat providers into pi-ai's images collection:"},"2545":{"id":"/docs/deep-exploration/external-capability-integration-domain-150","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#53-provider-bridging-for-generation","content":"Loads the collection via `getImagesModels()`, which imports `@earendil-works/pi-ai/providers/all` and calls `builtinImagesModels()` (the file header documents why the root exports must not be used — they return an empty array silently)."},"2546":{"id":"/docs/deep-exploration/external-capability-integration-domain-151","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#53-provider-bridging-for-generation","content":"Discovers likely image-generating models in the chat registry (`listRegistryImageGenModels`, heuristic name matching since the registry drops any `output` field)."},"2547":{"id":"/docs/deep-exploration/external-capability-integration-domain-152","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#53-provider-bridging-for-generation","content":"Groups them by provider with `groupModelsByProvider`, skipping providers without a resolvable `baseUrl`."},"2548":{"id":"/docs/deep-exploration/external-capability-integration-domain-153","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#53-provider-bridging-for-generation","content":"For each provider not already served natively by pi-ai, calls `createImagesProvider({ id, models, api: imagesApi, auth })`, where `auth.apiKey.resolve` returns an `AuthResult` sourced from Pi's own credential store so the user never logs in twice."},"2549":{"id":"/docs/deep-exploration/external-capability-integration-domain-154","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#53-provider-bridging-for-generation","content":"The function is idempotent (`registered` flag, `force` override) and best-effort; it is invoked at `session_start` and again inside `image_generate`."},"2550":{"id":"/docs/deep-exploration/external-capability-integration-domain-155","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#53-provider-bridging-for-generation","content":"`openai-images-api.ts` is the single generic adapter behind every bridged provider. It POSTs to `{baseUrl}/images/generations` (edits use the same endpoint with an `image` array, since multipart `/images/edits` is rejected by most gateways) with a 240-second default timeout. `normalizeImageItem` accepts the three observed response shapes — `{ b64_json, media_type }`, `{ b64_json, revised_prompt }` and `{ url: \"data:…\" }` — and surfaces a plain remote URL as text rather than silently dropping it."},"2551":{"id":"/docs/deep-exploration/external-capability-integration-domain-156","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#54-image_generate","content":"Parameters: `prompt`, optional `image` (path, `data:` URL or raw base64 — an input image switches to edit mode) and optional `model` override. Execution resolves the requested model against `listAllImageGenModels`, fills in `baseUrl` from the registry when a user typed `provider/model-id`, resolves a fallback API key through `registry.getApiKeyForProvider` or `<PROVIDER>_API_KEY`, and calls `generateImage`. Results are returned inline as `image` content blocks and optionally saved under the configured output directory (`IMAGE_DIRS.OUTPUT = ~/.unipi/images`)."},"2552":{"id":"/docs/deep-exploration/external-capability-integration-domain-157","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#55-image_recognize","content":"Parameters: `image`, optional `prompt` (default \"Describe this image in detail.\"), `model`, `systemPrompt`. Model precedence is per-call override → configured model → current session model. `resolveVisionModel` restricts the choice to image-capable registry models with exact, id, then fuzzy scoring; a known-but-blind model yields a targeted \"does not accept image input\" error, and a well-formed unknown `provider/id` is accepted as an escape hatch. `recognize.ts` then dispatches per API family — `callAnthropic` for the Messages API (nested `source` image part, `anthropic-version: 2023-06-01`) or an OpenAI-compatible chat completion that accumulates SSE deltas — with a 120-second timeout combined with the tool's abort signal and a 2 048-token reply cap."},"2553":{"id":"/docs/deep-exploration/external-capability-integration-domain-158","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#61-responsibilities","content":"Fusion lets the user run the session on a strong *lead* model while delegating implementation and verification chores to a cheaper *sidekick* model in a persistent child process. The package supplies the picker UI, the layered preset that keeps the picker's list finite, the runtime that drives the sidekick, the `sidekick`/`read_subagent` tools, prompt-level nudges that steer the lead towards delegation, and a savings estimate published to the footer."},"2554":{"id":"/docs/deep-exploration/external-capability-integration-domain-159","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#61-responsibilities","content":"The extension is a no-op inside its own children: `fusionExtension` returns immediately when `UNIPI_FUSION_CHILD === \"1\"`."},"2555":{"id":"/docs/deep-exploration/external-capability-integration-domain-160","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#62-layered-preset-presetts","content":"Layer"},"2556":{"id":"/docs/deep-exploration/external-capability-integration-domain-161","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#62-layered-preset-presetts","content":"Path"},"2557":{"id":"/docs/deep-exploration/external-capability-integration-domain-162","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#62-layered-preset-presetts","content":"Merge semantics"},"2558":{"id":"/docs/deep-exploration/external-capability-integration-domain-163","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#62-layered-preset-presetts","content":"global"},"2559":{"id":"/docs/deep-exploration/external-capability-integration-domain-164","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#62-layered-preset-presetts","content":"`~/.unipi/config/fusion/preset.json`"},"2560":{"id":"/docs/deep-exploration/external-capability-integration-domain-165","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#62-layered-preset-presetts","content":"base"},"2561":{"id":"/docs/deep-exploration/external-capability-integration-domain-166","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#62-layered-preset-presetts","content":"project"},"2562":{"id":"/docs/deep-exploration/external-capability-integration-domain-167","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#62-layered-preset-presetts","content":"`<cwd>/.unipi/fusion-preset.json`"},"2563":{"id":"/docs/deep-exploration/external-capability-integration-domain-168","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#62-layered-preset-presetts","content":"on top; arrays (`lead`, `sidekick`, `recent`) replace, objects (`default`, `effort`, `badges`, `prices`) deep-merge"},"2564":{"id":"/docs/deep-exploration/external-capability-integration-domain-169","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#62-layered-preset-presetts","content":"`FusionPreset` holds `lead[]`, `sidekick[]`, `default {lead, sidekick}`, per-model `effort` (one of `off|minimal|low|medium|high|xhigh|max`), an MRU `recent` list capped at 5, hand-curated `badges` (`new|promotion|beta`), manual `prices` overrides for providers that report no pricing, and the `active` selection (`{kind:\"single\", model}` or `{kind:\"fusion\", lead, sidekick, leadEffort?, sidekickEffort?}`). `parsePreset` validates every field defensively. Writes go through `writeJsonAtomic` (temp file + `renameSync`). `saveCuration` writes the lead/sidekick/default lists to the chosen layer, while `saveRuntimeState` (effort, recent, active) always writes to the global layer."},"2565":{"id":"/docs/deep-exploration/external-capability-integration-domain-170","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#63-commands-and-picker-flow","content":"`createModelBoostProvider` wraps the host autocomplete provider so that while the user types `/model…`, `/unipi:model` is moved to the first suggestion — the only way to \"override\" Pi's built-in `/model`, which extensions cannot replace. On `session_start` the extension restores the persisted active pair (switching the session model back to the lead, or turning Fusion off with a warning if the lead is unavailable) and registers the autocomplete provider. On `model_select` triggered by Pi's own picker, Fusion leaves fusion mode unless the chosen model is still the lead."},"2566":{"id":"/docs/deep-exploration/external-capability-integration-domain-171","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#64-sidekickruntime","content":"`sidekick-runtime.ts` manages one child Pi process per session:"},"2567":{"id":"/docs/deep-exploration/external-capability-integration-domain-172","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#64-sidekickruntime","content":"**Spawn.** Writes the sidekick system prompt to a temp file and runs `getPiSpawnCommand([\"--mode\",\"rpc\",\"--session\",<file>,\"--model\",<sidekick>,\"--thinking\",<effort>,\"--append-system-prompt\",<tmp>,\"--no-skills\"])` with `UNIPI_FUSION_CHILD=1` and `UNIPI_SUBAGENT_CHILD=1` in the environment. The session file lives at `~/.unipi/state/fusion/sidekick/<leadSessionId>.jsonl`, so sidekick context and shells persist across handoffs. Spawning is lazy: the first `handoff()` on a dead runtime starts the process."},"2568":{"id":"/docs/deep-exploration/external-capability-integration-domain-173","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#64-sidekickruntime","content":"**Protocol.** stdin receives newline-delimited JSON commands (`prompt`, `steer`, `abort`, `get_last_assistant_text`, `extension_ui_response`); stdout is parsed line-by-line in `readStdout`/`handleMessage`. `tool_execution_start`/`end` update `HandoffProgress` (tool call count, last six tool summaries, event list bounded to `MAX_EVENTS = 300` with a `droppedEvents` counter, tool output tail bounded to `MAX_TOOL_OUTPUT = 4000`); `message_update` text deltas maintain a 400-character `textTail`; `message_end` accumulates `SidekickUsage` (input, output, cacheRead, cacheWrite, cost) both per handoff and runtime-wide; `agent_settled` triggers `get_last_assistant_text`, whose response finalizes the `HandoffReport` with status `completed`, `aborted` or `error`. UI requests from the child (`select`, `confirm`, `input`, `editor`) are auto-cancelled so the sidekick never blocks on a prompt nobody can see."},"2569":{"id":"/docs/deep-exploration/external-capability-integration-domain-174","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#64-sidekickruntime","content":"**Steering.** Calling `handoff()` while a handoff is pending sends a `steer` message instead of starting a second sidekick."},"2570":{"id":"/docs/deep-exploration/external-capability-integration-domain-175","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#64-sidekickruntime","content":"**Teardown.** `kill()` removes the temp prompt, sends `SIGTERM`, and escalates to `SIGKILL` after two seconds."},"2571":{"id":"/docs/deep-exploration/external-capability-integration-domain-176","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#65-tools-and-lead-policy","content":"`tools.ts` registers two tools with custom `renderCall`/`renderResult` components (framed transcripts via `transcript.ts`) and a `sidekick-completion` message renderer:"},"2572":{"id":"/docs/deep-exploration/external-capability-integration-domain-177","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#65-tools-and-lead-policy","content":"Tool"},"2573":{"id":"/docs/deep-exploration/external-capability-integration-domain-178","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#65-tools-and-lead-policy","content":"Parameters"},"2574":{"id":"/docs/deep-exploration/external-capability-integration-domain-179","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#65-tools-and-lead-policy","content":"Behaviour"},"2575":{"id":"/docs/deep-exploration/external-capability-integration-domain-180","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#65-tools-and-lead-policy","content":"`sidekick`"},"2576":{"id":"/docs/deep-exploration/external-capability-integration-domain-181","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#65-tools-and-lead-policy","content":"`message`, `block? = true`"},"2577":{"id":"/docs/deep-exploration/external-capability-integration-domain-182","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#65-tools-and-lead-policy","content":"Starts or steers a handoff. Blocking mode polls every 500 ms (default ceiling 2 700 s), streams progress through `onUpdate`, honours the abort signal, and yields early with an explanatory message if `ctx.hasPendingMessages()` reports a new user message. Non-blocking mode returns immediately and later delivers a `<subagent_completion_notification>` via `pi.sendMessage(..., { deliverAs: \"followUp\", triggerTurn: true })`."},"2578":{"id":"/docs/deep-exploration/external-capability-integration-domain-183","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#65-tools-and-lead-policy","content":"`read_subagent`"},"2579":{"id":"/docs/deep-exploration/external-capability-integration-domain-184","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#65-tools-and-lead-policy","content":"`agent_id?`, `block?`, `timeout?`"},"2580":{"id":"/docs/deep-exploration/external-capability-integration-domain-185","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#65-tools-and-lead-policy","content":"Returns a stored report, a progress snapshot, or waits for the latest handoff."},"2581":{"id":"/docs/deep-exploration/external-capability-integration-domain-186","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#65-tools-and-lead-policy","content":"`index.ts` shapes the lead's behaviour through hooks: `before_agent_start` appends `leadPolicy(identity)` to the system prompt while a Fusion pair is active; `tool_result` counts lead tool calls, appends `EDIT_NUDGE` once per turn after an `edit`/`write`, and appends `bashNudge(streak)` after `BASH_NUDGE_EVERY = 4` consecutive non-trivial shell commands (`isTrivialShell` whitelists read-only commands such as `git status`, `ls`, `cat`, `rg`). Calls to `sidekick`/`read_subagent` reset the streak."},"2582":{"id":"/docs/deep-exploration/external-capability-integration-domain-187","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#66-savings-and-status-publication","content":"`savings.ts#estimateSavings(usage, leadCost, sideCost)` prices the sidekick's accumulated tokens at both models' per-million rates (cache writes billed at input rate, cache reads at `cachedInput`) and reports `sidekickUsd`, `atLeadUsd` and `savedUsd`. When no pricing is available it falls back to the provider-reported `usage.cost`. `publishStatus` writes a `SharedFusionStatus` (`leadName`, `leadEffort`, `sidekickName`, `sidekickEffort`, `savedUsd`, `busy`, `leadToolCalls`, `sidekickToolCalls`) into the `Symbol.for(\"unipi.fusion.status\")` slot defined in `core/fusion-status.ts`; the footer reads it synchronously to render `Fusion · Lead ◆ Sidekick`. `/unipi:fusion-stats` prints the same numbers as text, with a hint to set `prices` in the preset when the provider reports none."},"2583":{"id":"/docs/deep-exploration/external-capability-integration-domain-188","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#71-event-bus","content":"Emitter"},"2584":{"id":"/docs/deep-exploration/external-capability-integration-domain-189","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#71-event-bus","content":"Event"},"2585":{"id":"/docs/deep-exploration/external-capability-integration-domain-190","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#71-event-bus","content":"Payload highlights"},"2586":{"id":"/docs/deep-exploration/external-capability-integration-domain-191","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#71-event-bus","content":"mcp"},"2587":{"id":"/docs/deep-exploration/external-capability-integration-domain-192","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#71-event-bus","content":"`MCP_SERVER_STARTED` / `MCP_SERVER_STOPPED` / `MCP_SERVER_ERROR`"},"2588":{"id":"/docs/deep-exploration/external-capability-integration-domain-193","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#71-event-bus","content":"`name`, `toolCount`, `error`"},"2589":{"id":"/docs/deep-exploration/external-capability-integration-domain-194","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#71-event-bus","content":"mcp"},"2590":{"id":"/docs/deep-exploration/external-capability-integration-domain-195","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#71-event-bus","content":"`MCP_TOOLS_REGISTERED` / `MCP_TOOLS_UNREGISTERED`"},"2591":{"id":"/docs/deep-exploration/external-capability-integration-domain-196","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#71-event-bus","content":"`serverName`, sorted `toolNames`"},"2592":{"id":"/docs/deep-exploration/external-capability-integration-domain-197","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#71-event-bus","content":"mcp"},"2593":{"id":"/docs/deep-exploration/external-capability-integration-domain-198","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#71-event-bus","content":"`MCP_CATALOG_SYNCED`"},"2594":{"id":"/docs/deep-exploration/external-capability-integration-domain-199","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#71-event-bus","content":"`totalServers`, `source`"},"2595":{"id":"/docs/deep-exploration/external-capability-integration-domain-200","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#71-event-bus","content":"mcp, web-api, image"},"2596":{"id":"/docs/deep-exploration/external-capability-integration-domain-201","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#71-event-bus","content":"`MODULE_READY`"},"2597":{"id":"/docs/deep-exploration/external-capability-integration-domain-202","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#71-event-bus","content":"`name`, `version`, `commands`, `tools` (post-gating for image)"},"2598":{"id":"/docs/deep-exploration/external-capability-integration-domain-203","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#71-event-bus","content":"All events go through `emitEvent(pi, event, payload)` from core. `notify`, `footer` and subagent prompt builders consume these to discover what the domain currently offers."},"2599":{"id":"/docs/deep-exploration/external-capability-integration-domain-204","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#72-shared-global-state","content":"`globalThis.__unipi_info_registry` — mcp, web-api and image register info-screen groups (`mcp` priority 15, `web-api` 50, `image` 55) with async `dataProvider` callbacks."},"2600":{"id":"/docs/deep-exploration/external-capability-integration-domain-205","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#72-shared-global-state","content":"`Symbol.for(\"unipi.fusion.status\")` — fusion publishes, footer consumes."},"2601":{"id":"/docs/deep-exploration/external-capability-integration-domain-206","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#73-on-disk-state","content":"Package"},"2602":{"id":"/docs/deep-exploration/external-capability-integration-domain-207","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#73-on-disk-state","content":"Path"},"2603":{"id":"/docs/deep-exploration/external-capability-integration-domain-208","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#73-on-disk-state","content":"Purpose"},"2604":{"id":"/docs/deep-exploration/external-capability-integration-domain-209","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#73-on-disk-state","content":"mcp"},"2605":{"id":"/docs/deep-exploration/external-capability-integration-domain-210","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#73-on-disk-state","content":"`~/.unipi/config/mcp/{mcp-config.json, config.json, servers.json}`, `<cwd>/.unipi/config/mcp/…`"},"2606":{"id":"/docs/deep-exploration/external-capability-integration-domain-211","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#73-on-disk-state","content":"Server definitions (chmod 600), metadata, catalog cache"},"2607":{"id":"/docs/deep-exploration/external-capability-integration-domain-212","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#73-on-disk-state","content":"web-api"},"2608":{"id":"/docs/deep-exploration/external-capability-integration-domain-213","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#73-on-disk-state","content":"`~/.unipi/config/web-api/cache/<sha256>.json`"},"2609":{"id":"/docs/deep-exploration/external-capability-integration-domain-214","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#73-on-disk-state","content":"TTL cache entries"},"2610":{"id":"/docs/deep-exploration/external-capability-integration-domain-215","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#73-on-disk-state","content":"image"},"2611":{"id":"/docs/deep-exploration/external-capability-integration-domain-216","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#73-on-disk-state","content":"`~/.unipi/config/image`, `~/.unipi/images`"},"2612":{"id":"/docs/deep-exploration/external-capability-integration-domain-217","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#73-on-disk-state","content":"Config, saved generations"},"2613":{"id":"/docs/deep-exploration/external-capability-integration-domain-218","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#73-on-disk-state","content":"fusion"},"2614":{"id":"/docs/deep-exploration/external-capability-integration-domain-219","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#73-on-disk-state","content":"`~/.unipi/config/fusion/preset.json`, `<cwd>/.unipi/fusion-preset.json`, `~/.unipi/state/fusion/sidekick/<session>.jsonl`"},"2615":{"id":"/docs/deep-exploration/external-capability-integration-domain-220","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#73-on-disk-state","content":"Layered preset, sidekick session transcript"},"2616":{"id":"/docs/deep-exploration/external-capability-integration-domain-221","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#74-host-api-adaptation","content":"The domain repeatedly adapts to host-version differences: `mcp/index.ts` chooses between `registerTool`/`registerExternalTool` and detects whether unregistration exists; `image` reads `ctx.modelRegistry` structurally and treats missing pi-ai exports as \"no models\"; `fusion` reads `ctx.thinkingLevel` or `pi.getThinkingLevel()` and tolerates providers without thinking support."},"2617":{"id":"/docs/deep-exploration/external-capability-integration-domain-222","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#8-observations-and-recommendations","content":"**The `ServerRegistry` barrier is a reusable pattern.** Its \"prepare everything, validate, then commit in deterministic order, roll back on failure\" shape would suit any other place in Unipi that registers dynamic tool sets (for example, subagent-provided tools)."},"2618":{"id":"/docs/deep-exploration/external-capability-integration-domain-223","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#8-observations-and-recommendations","content":"**Three independent child-process managers.** `McpClient`, `SidekickRuntime` and the orchestration domain's runners each implement spawn, newline-delimited JSON framing, stderr tailing and SIGTERM→SIGKILL escalation. A shared primitive in `@pi-unipi/utility` would reduce duplicated edge-case handling (e.g. Windows tree termination is handled only in background-tasks today)."},"2619":{"id":"/docs/deep-exploration/external-capability-integration-domain-224","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#8-observations-and-recommendations","content":"**`MODULES` lacks a `FUSION` entry.** `core/constants.ts` has no `MODULES.FUSION`, and `fusion/index.ts` does not emit `MODULE_READY`; the fusion package is therefore invisible to `notify`'s dynamic discovery even though it registers two agent tools. Adding the constant and the announcement would align it with its three sibling packages."},"2620":{"id":"/docs/deep-exploration/external-capability-integration-domain-225","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#8-observations-and-recommendations","content":"**Provider ranks are duplicated in prose.** The rank→provider mapping lives in each provider's `ranking` object *and* in the hand-written tool descriptions in `tools.ts`. Generating the description text from the registry at registration time would prevent drift when providers are added or re-ranked."},"2621":{"id":"/docs/deep-exploration/external-capability-integration-domain-226","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#8-observations-and-recommendations","content":"**MCP notifications are discarded.** `McpClient` ignores server-initiated notifications (e.g. `notifications/tools/list_changed`). Handling that notification would allow tool sets to refresh without a restart on hosts that support unregistration."},"2622":{"id":"/docs/deep-exploration/external-capability-integration-domain-227","page_id":"/docs/deep-exploration/external-capability-integration-domain","tags":[],"type":"text","url":"/docs/deep-exploration/external-capability-integration-domain#8-observations-and-recommendations","content":"**Cache key granularity.** `WebCache` keys on `provider:url` but the smart-fetch key string also folds in `browser`, `format` and `maxChars`; `os`, `removeImages` and `includeReplies` are not part of the key, so two reads that differ only in those options share a cache entry. This is an acceptable trade-off but worth documenting for users who toggle those flags."},"2623":{"id":"/docs/deep-exploration/platform-core-and-shared-infrastructure-domain","page_id":"/docs/deep-exploration/platform-core-and-shared-infrastructure-domain","type":"page","content":"Platform Core & Shared Infrastructure","breadcrumbs":["Documentation","Deep Exploration"],"tags":[],"url":"/docs/deep-exploration/platform-core-and-shared-infrastructure-domain"},"2624":{"id":"/docs/deep-exploration/platform-core-and-shared-infrastructure-domain-0","page_id":"/docs/deep-exploration/platform-core-and-shared-infrastructure-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/platform-core-and-shared-infrastructure-domain#1-overview","content":"1\\. Overview"},"2625":{"id":"/docs/deep-exploration/platform-core-and-shared-infrastructure-domain-1","page_id":"/docs/deep-exploration/platform-core-and-shared-infrastructure-domain","type":"heading","tags":[],"url":"/d