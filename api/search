eep-exploration/context-and-memory-management-domain#8-persistence-inventory","content":"memory"},"2370":{"id":"/docs/deep-exploration/context-and-memory-management-domain-218","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#8-persistence-inventory","content":"YAML frontmatter + markdown body"},"2371":{"id":"/docs/deep-exploration/context-and-memory-management-domain-219","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#8-persistence-inventory","content":"MemPalace palace"},"2372":{"id":"/docs/deep-exploration/context-and-memory-management-domain-220","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#8-persistence-inventory","content":"`~/.mempalace/palace`"},"2373":{"id":"/docs/deep-exploration/context-and-memory-management-domain-221","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#8-persistence-inventory","content":"memory (via bridge)"},"2374":{"id":"/docs/deep-exploration/context-and-memory-management-domain-222","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#8-persistence-inventory","content":"Managed by MemPalace"},"2375":{"id":"/docs/deep-exploration/context-and-memory-management-domain-223","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#8-persistence-inventory","content":"Memory flags"},"2376":{"id":"/docs/deep-exploration/context-and-memory-management-domain-224","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#8-persistence-inventory","content":"`~/.unipi/memory/.mempalace-{install,migrated,ping-verified,update}`"},"2377":{"id":"/docs/deep-exploration/context-and-memory-management-domain-225","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#8-persistence-inventory","content":"memory"},"2378":{"id":"/docs/deep-exploration/context-and-memory-management-domain-226","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#8-persistence-inventory","content":"JSON / timestamp caches"},"2379":{"id":"/docs/deep-exploration/context-and-memory-management-domain-227","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#8-persistence-inventory","content":"Telemetry sidecar"},"2380":{"id":"/docs/deep-exploration/context-and-memory-management-domain-228","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#8-persistence-inventory","content":"`~/.unipi/trajectory/<sessionId>.jsonl`"},"2381":{"id":"/docs/deep-exploration/context-and-memory-management-domain-229","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#8-persistence-inventory","content":"trajectory"},"2382":{"id":"/docs/deep-exploration/context-and-memory-management-domain-230","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#8-persistence-inventory","content":"Redacted JSONL, 0600"},"2383":{"id":"/docs/deep-exploration/context-and-memory-management-domain-231","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#9-design-patterns-and-engineering-observations","content":"**Pure core, impure edges.** Both the compile pipeline and the auto-trigger are pure functions over plain data; all Pi/host interaction is confined to `hooks.ts` and `src/index.ts`. This makes the highest-risk logic (what gets thrown away) unit-testable and reproducible."},"2384":{"id":"/docs/deep-exploration/context-and-memory-management-domain-232","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#9-design-patterns-and-engineering-observations","content":"**Hidden messages instead of system-prompt edits.** Resume snapshots, memory reminders and the auto-continue marker are all delivered as `display: false` custom messages, and the auto-continue marker is additionally filtered from the LLM payload. This preserves the stable prompt prefix that provider caching depends on — a property the trajectory package explicitly monitors."},"2385":{"id":"/docs/deep-exploration/context-and-memory-management-domain-233","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#9-design-patterns-and-engineering-observations","content":"**Fail-soft by default.** SessionDB init failure, MemPalace unavailability, security-check errors and bridge timeouts all degrade rather than crash. The `input` security hook is explicitly advisory (\"fail-open\")."},"2386":{"id":"/docs/deep-exploration/context-and-memory-management-domain-234","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#9-design-patterns-and-engineering-observations","content":"**Startup latency as a constraint.** Orphan sync is deferred to first use, ping verification is cached for 24 h, status counts are resolved asynchronously, and `node:fs` is lazily imported on debug paths."},"2387":{"id":"/docs/deep-exploration/context-and-memory-management-domain-235","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#9-design-patterns-and-engineering-observations","content":"**Bounded everything.** Section caps (8/15 lines), file caps (10 per category), brief budgets in tokens, 1000 events per session, 5 MB telemetry tail, 2 MB per event, 64 MiB bridge buffer."},"2388":{"id":"/docs/deep-exploration/context-and-memory-management-domain-236","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#points-worth-noting-for-maintainers","content":"**Two `session_before_compact` handlers** exist in the compactor (`index.ts` for resume snapshots, `hooks.ts` for the summary). They are independent but both rely on the closure-held `currentSessionId`, since the event does not carry a session id."},"2389":{"id":"/docs/deep-exploration/context-and-memory-management-domain-237","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#points-worth-noting-for-maintainers","content":"**`session_compact` statistics in `index.ts` are heuristic** (assumes \\~12 % retained, 500 tokens/event) and are recorded in addition to the precise stats written by `hooks.ts`; consumers of `compactor_stats` should be aware the two feeds are combined."},"2390":{"id":"/docs/deep-exploration/context-and-memory-management-domain-238","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#points-worth-noting-for-maintainers","content":"**`RECALL_NOTE` references `vcc_recall`**, the deprecated alias, while the preferred tool name is `session_recall`; both remain registered."},"2391":{"id":"/docs/deep-exploration/context-and-memory-management-domain-239","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#points-worth-noting-for-maintainers","content":"**The MemPalace fallback comment is stale**: `mempalace.ts` describes a legacy SQLite fallback, but `MemoryStorage.init()` throws and the extension runs without memory instead."},"2392":{"id":"/docs/deep-exploration/context-and-memory-management-domain-240","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#points-worth-noting-for-maintainers","content":"**Mixed responsibilities**: the `PolyglotExecutor` and security scanner live inside the compactor although they are orthogonal to compaction; the architecture review suggests extracting them into a dedicated sandbox package."},"2393":{"id":"/docs/deep-exploration/context-and-memory-management-domain-241","page_id":"/docs/deep-exploration/context-and-memory-management-domain","tags":[],"type":"text","url":"/docs/deep-exploration/context-and-memory-management-domain#points-worth-noting-for-maintainers","content":"**Auto-compaction is disabled by default** (`enabled: false`) for backward compatibility; the compactor also only overrides Pi's native compaction when `overrideDefaultCompaction` is set or the compactor marker instruction is used."},"2394":{"id":"/docs/deep-exploration/external-capability-integration-domain","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"page","content":"External Capability Integration","breadcrumbs":["Documentation","Deep Exploration"],"tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain"},"2395":{"id":"/docs/deep-exploration/external-capability-integration-domain-0","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#1-purpose-and-scope","content":"1\\. Purpose and Scope"},"2396":{"id":"/docs/deep-exploration/external-capability-integration-domain-1","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#2-domain-architecture","content":"2\\. Domain Architecture"},"2397":{"id":"/docs/deep-exploration/external-capability-integration-domain-2","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#3-mcp-server-bridge-pi-unipimcp","content":"3\\. MCP Server Bridge (`@pi-unipi/mcp`)"},"2398":{"id":"/docs/deep-exploration/external-capability-integration-domain-3","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#31-responsibilities","content":"3.1 Responsibilities"},"2399":{"id":"/docs/deep-exploration/external-capability-integration-domain-4","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integration-domain#32-configuration-layer","content":"3.2 Configuration Layer"},"2400":{"id":"/docs/deep-exploration/external-capability-integration-domain-5","page_id":"/docs/deep-exploration/external-capability-integration-domain","type":"heading","tags":[],"url":"/docs/deep-exploration/external-capability-integrat