id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"`checkExistingInstance()`"},"3191":{"id":"/docs/deep-exploration/structured-development-workflow-domain-254","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"Reads the PID file and probes with `process.kill(pid, 0)`; returns a descriptive URL string or `null`."},"3192":{"id":"/docs/deep-exploration/structured-development-workflow-domain-255","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"`startServer(config?)` composes the default application: instantiate `KanboardServer`, lazily import and call `registerMilestoneRoutes(server, docsRoot)` and `registerWorkflowRoutes(server, docsRoot)`, then `start()`."},"3193":{"id":"/docs/deep-exploration/structured-development-workflow-domain-256","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"**Routes:**"},"3194":{"id":"/docs/deep-exploration/structured-development-workflow-domain-257","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"Route"},"3195":{"id":"/docs/deep-exploration/structured-development-workflow-domain-258","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"Registry"},"3196":{"id":"/docs/deep-exploration/structured-development-workflow-domain-259","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"Response"},"3197":{"id":"/docs/deep-exploration/structured-development-workflow-domain-260","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"`GET /`"},"3198":{"id":"/docs/deep-exploration/structured-development-workflow-domain-261","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"Fresh `ParserRegistry` with only `MilestoneParser`; parses `<docsRoot>/MILESTONES.md`"},"3199":{"id":"/docs/deep-exploration/structured-development-workflow-domain-262","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"`renderMilestonePage([doc])` HTML"},"3200":{"id":"/docs/deep-exploration/structured-development-workflow-domain-263","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"`GET /api/milestones`"},"3201":{"id":"/docs/deep-exploration/structured-development-workflow-domain-264","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"same"},"3202":{"id":"/docs/deep-exploration/structured-development-workflow-domain-265","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"JSON `ParsedDoc` or `{ items: [] }`"},"3203":{"id":"/docs/deep-exploration/structured-development-workflow-domain-266","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"`GET /workflow`"},"3204":{"id":"/docs/deep-exploration/structured-development-workflow-domain-267","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"`createDefaultRegistry()` created lazily on first request and cached"},"3205":{"id":"/docs/deep-exploration/structured-development-workflow-domain-268","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"`renderWorkflowPage(registry.parseAll(docsRoot))` HTML"},"3206":{"id":"/docs/deep-exploration/structured-development-workflow-domain-269","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"`GET /api/workflow`"},"3207":{"id":"/docs/deep-exploration/structured-development-workflow-domain-270","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"same"},"3208":{"id":"/docs/deep-exploration/structured-development-workflow-domain-271","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"JSON `{ docs: ParsedDoc[] }`"},"3209":{"id":"/docs/deep-exploration/structured-development-workflow-domain-272","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"`GET /static/*`"},"3210":{"id":"/docs/deep-exploration/structured-development-workflow-domain-273","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"—"},"3211":{"id":"/docs/deep-exploration/structured-development-workflow-domain-274","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"`app.js`, `style.css`"},"3212":{"id":"/docs/deep-exploration/structured-development-workflow-domain-275","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#54-http-server-serverindexts","content":"Every page request re-parses the files, so the board is always consistent with the current state of `.unipi/docs` without any watcher or cache invalidation."},"3213":{"id":"/docs/deep-exploration/structured-development-workflow-domain-276","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#55-server-rendered-ui-ui","content":"`renderLayout(title, content, activePage)` in `layouts/base.ts` emits the HTML shell: htmx 1.9.12 and Alpine.js 3.14.3 from unpkg, Google Fonts (Bodoni Moda, Onest, JetBrains Mono), `/static/style.css`, a navbar with `Milestones` (`/`) and `Workflow` (`/workflow`) links (with `aria-current=\"page\"` on the active one), a `<main class=\"container\">` slot and `/static/app.js`. `ActivePage` is the union `\"milestones\" | \"workflow\"`."},"3214":{"id":"/docs/deep-exploration/structured-development-workflow-domain-277","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#55-server-rendered-ui-ui","content":"**`renderMilestonePage(docs)`** (`ui/milestone/page.ts`): shows an empty state (\"No MILESTONES.md found\") if there is no document; otherwise reads `docs[0]`, computes overall done/total/percent, `groupByPhase()` strips the `[Phase]` prefix that `MilestoneParser` added (unprefixed items fall into `\"Other\"`), and renders one collapsible section per phase with a CSS-variable driven progress bar (`style=\"--progress: N;\"`), a checklist of items and any parser warnings."},"3215":{"id":"/docs/deep-exploration/structured-development-workflow-domain-278","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#55-server-rendered-ui-ui","content":"**`renderWorkflowPage(docs)`** (`ui/workflow/page.ts`): groups documents by `DocType` using `DOC_TYPE_CONFIG` (icon, label, colour per type), renders a section per type with document/item counts, and inside each an Alpine-powered `card` (`x-data=\"{ open: false }\"`) whose header toggles a `<template x-if=\"open\">` checklist. Card status is derived: no items → `todo` (or `done` for `quick-work`); all done → `done`; else `in-progress`. `done` and `reviewed` both count as complete. A filter bar bound to `kanboardFilters()` offers All / To Do / In Progress / Reviewed / Done."},"3216":{"id":"/docs/deep-exploration/structured-development-workflow-domain-279","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#55-server-rendered-ui-ui","content":"**Components** (`ui/components/`): `renderChecklist(items)`, `renderCopyButton(text, label?)` (truncates labels over 40 characters) and `renderStatusBadge(status)` are reusable helpers, each with a local `esc()` HTML-escaper. The page modules currently inline equivalent markup rather than importing these components."},"3217":{"id":"/docs/deep-exploration/structured-development-workflow-domain-280","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#55-server-rendered-ui-ui","content":"**Client script** (`ui/static/app.js`): `copyToClipboard(text, event)` writes to the clipboard and flashes \"copied\" for 1.8 s; `toggleSection(event)` animates section expand/collapse while honouring `prefers-reduced-motion`; `kanboardFilters()` returns the Alpine data object `{ filter, setFilter(f), isVisible(status) }`."},"3218":{"id":"/docs/deep-exploration/structured-development-workflow-domain-281","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#56-commands-and-process-management-commandsts-indexts","content":"`/unipi:kanboard` is a **toggle** with three cases:"},"3219":{"id":"/docs/deep-exploration/structured-development-workflow-domain-282","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#56-commands-and-process-management-commandsts-indexts","content":"A live `runningServer` reference exists in this process → `stop()` and notify \"Kanboard stopped\"."},"3220":{"id":"/docs/deep-exploration/structured-development-workflow-domain-283","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#56-commands-and-process-management-commandsts-indexts","content":"No reference, but `isPidFileRunning(pidFile)` reports a live PID → the file is treated as stale/external, deleted, and the user is told to run the command again."},"3221":{"id":"/docs/deep-exploration/structured-development-workflow-domain-284","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#56-commands-and-process-management-commandsts-indexts","content":"Otherwise → `startServer()`, store the reference and notify `Kanboard running at http://localhost:<port>`."},"3222":{"id":"/docs/deep-exploration/structured-development-workflow-domain-285","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#56-commands-and-process-management-commandsts-indexts","content":"`isPidFileRunning` uses `process.kill(pid, 0)` as a liveness probe and unlinks the PID file when the process is gone. `/unipi:kanboard-doctor` only shows a notification; the diagnostic instructions live in `skills/kanboard-doctor/` and are surfaced through Pi's skill discovery."},"3223":{"id":"/docs/deep-exploration/structured-development-workflow-domain-286","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#56-commands-and-process-management-commandsts-indexts","content":"`index.ts` registers a `kanboard` info-screen group (priority 50) whose `dataProvider` builds a default registry, runs `parseAll(\".unipi/docs\")` and reports document and task counts. Unlike the other two packages, kanboard does **not** emit `MODULE_READY`."},"3224":{"id":"/docs/deep-exploration/structured-development-workflow-domain-287","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#6-end-to-end-domain-flow","content":"The three packages compose into a closed loop without any of them calling the others directly:"},"3225":{"id":"/docs/deep-exploration/structured-development-workflow-domain-288","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#6-end-to-end-domain-flow","content":"Cross-domain touch points visible in code:"},"3226":{"id":"/docs/deep-exploration/structured-development-workflow-domain-289","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#6-end-to-end-domain-flow","content":"**Ralph (Agent Orchestration):** detected via the `ralph_start` tool or `MODULE_READY`; `work` appends a hint and `/unipi:ralph-start` bridges to a loop."},"3227":{"id":"/docs/deep-exploration/structured-development-workflow-domain-290","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#6-end-to-end-domain-flow","content":"**Info-screen (Interaction & Presentation):** milestone and kanboard publish stat groups through `globalThis.__unipi_info_registry`."},"3228":{"id":"/docs/deep-exploration/structured-development-workflow-domain-291","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#6-end-to-end-domain-flow","content":"**Footer:** `workflow` and `kanboard` segments in `@pi-unipi/footer` consume `WORKFLOW_START/END` and status; the workflow package also writes `ctx.ui.setStatus(\"unipi-workflow\", …)` directly."},"3229":{"id":"/docs/deep-exploration/structured-development-workflow-domain-292","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#6-end-to-end-domain-flow","content":"**Compactor (Context & Memory):** both snapshot mechanisms explicitly account for compaction by checking raw `SessionEntry` history for snapshots whose custom-message identity may have been summarised away."},"3230":{"id":"/docs/deep-exploration/structured-development-workflow-domain-293","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Decision"},"3231":{"id":"/docs/deep-exploration/structured-development-workflow-domain-294","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Where"},"3232":{"id":"/docs/deep-exploration/structured-development-workflow-domain-295","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Rationale visible in code"},"3233":{"id":"/docs/deep-exploration/structured-development-workflow-domain-296","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Enforce sandboxes at `tool_call` instead of filtering registered tools"},"3234":{"id":"/docs/deep-exploration/structured-development-workflow-domain-297","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"`workflow/index.ts`, `core/sandbox.ts`"},"3235":{"id":"/docs/deep-exploration/structured-development-workflow-domain-298","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Keeps provider tool schemas and order stable (\"cache-stable call-time enforcement\"), preserving prompt caching."},"3236":{"id":"/docs/deep-exploration/structured-development-workflow-domain-299","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Surface sandbox/milestone state as hidden, append-only custom messages"},"3237":{"id":"/docs/deep-exploration/structured-development-workflow-domain-300","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"`workflow/index.ts`, `milestone/hooks.ts`"},"3238":{"id":"/docs/deep-exploration/structured-development-workflow-domain-301","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Avoids mutating the system prompt; each snapshot states it supersedes earlier ones so stale state in history cannot mislead the model."},"3239":{"id":"/docs/deep-exploration/structured-development-workflow-domain-302","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Single-slot `WorkflowLifecycle`"},"3240":{"id":"/docs/deep-exploration/structured-development-workflow-domain-303","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"`workflow/lifecycle.ts`"},"3241":{"id":"/docs/deep-exploration/structured-development-workflow-domain-304","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Guarantees one active sandbox per session and gives `WORKFLOW_END` a well-defined duration and success flag."},"3242":{"id":"/docs/deep-exploration/structured-development-workflow-domain-305","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Skills as `SKILL.md` delivered via `sendUserMessage(followUp)`"},"3243":{"id":"/docs/deep-exploration/structured-development-workflow-domain-306","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"`workflow/commands.ts`, `milestone/commands.ts`"},"3244":{"id":"/docs/deep-exploration/structured-development-workflow-domain-307","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Behaviour lives in editable markdown; the TypeScript is a thin dispatcher."},"3245":{"id":"/docs/deep-exploration/structured-development-workflow-domain-308","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Atomic writes for `MILESTONES.md`"},"3246":{"id":"/docs/deep-exploration/structured-development-workflow-domain-309","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"`milestone/milestone.ts`"},"3247":{"id":"/docs/deep-exploration/structured-development-workflow-domain-310","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"`.tmp` + `rename` prevents a half-written milestone file if the process dies mid-sync."},"3248":{"id":"/docs/deep-exploration/structured-development-workflow-domain-311","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Config-driven `CheckboxParser`"},"3249":{"id":"/docs/deep-exploration/structured-development-workflow-domain-312","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"`kanboard/parser/checkbox-parser.ts`"},"3250":{"id":"/docs/deep-exploration/structured-development-workflow-domain-313","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Collapsed seven parser classes into data; adding a doc type is a config entry."},"3251":{"id":"/docs/deep-exploration/structured-development-workflow-domain-314","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Inline milestone parsing in kanboard"},"3252":{"id":"/docs/deep-exploration/structured-development-workflow-domain-315","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"`kanboard/parser/milestones.ts`"},"3253":{"id":"/docs/deep-exploration/structured-development-workflow-domain-316","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Avoids a runtime dependency on `@pi-unipi/milestone`, at the cost of duplicated grammar."},"3254":{"id":"/docs/deep-exploration/structured-development-workflow-domain-317","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Framework-free HTTP server, CDN-loaded htmx/Alpine"},"3255":{"id":"/docs/deep-exploration/structured-development-workflow-domain-318","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"`kanboard/server`, `kanboard/ui`"},"3256":{"id":"/docs/deep-exploration/structured-development-workflow-domain-319","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Zero additional npm dependencies; parses on every request so no cache to invalidate."},"3257":{"id":"/docs/deep-exploration/structured-development-workflow-domain-320","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"PID file + `process.kill(pid, 0)`"},"3258":{"id":"/docs/deep-exploration/structured-development-workflow-domain-321","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"`kanboard/commands.ts`, `server/index.ts`"},"3259":{"id":"/docs/deep-exploration/structured-development-workflow-domain-322","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#7-design-decisions-and-rationale","content":"Detects servers left over from earlier Pi sessions without a daemon."},"3260":{"id":"/docs/deep-exploration/structured-development-workflow-domain-323","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#8-observations-and-maintenance-notes","content":"The following points were confirmed against source and are worth knowing when extending the domain:"},"3261":{"id":"/docs/deep-exploration/structured-development-workflow-domain-324","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#8-observations-and-maintenance-notes","content":"**Stale header in `kanboard/parser/milestones.ts`.** The comment claims delegation to `@pi-unipi/milestone`; the implementation is inline. Any change to the `MILESTONES.md` grammar must be applied in both `milestone/milestone.ts` and `kanboard/parser/milestones.ts`."},"3262":{"id":"/docs/deep-exploration/structured-development-workflow-domain-325","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#8-observations-and-maintenance-notes","content":"**Version reporting is inconsistent.** `workflow` reads its version via `getPackageVersion`; `milestone` and `kanboard` hard-code `\"0.1.0\"`."},"3263":{"id":"/docs/deep-exploration/structured-development-workflow-domain-326","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#8-observations-and-maintenance-notes","content":"**`kanboard` never emits `MODULE_READY`**, so peers that rely on discovery (notify, footer) cannot detect it through the event bus; the footer's kanboard segment must use another signal."},"3264":{"id":"/docs/deep-exploration/structured-development-workflow-domain-327","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#8-observations-and-maintenance-notes","content":"**Hook naming.** `registerSessionStartHook` installs a `before_agent_start` handler, and `registerSessionEndHook` listens to `WORKFLOW_END` plus `session_shutdown`; the names describe intent rather than the exact Pi hook."},"3265":{"id":"/docs/deep-exploration/structured-development-workflow-domain-328","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#8-observations-and-maintenance-notes","content":"**Unused state.** `frontmatterDone` in both milestone parsers is assigned but never read."},"3266":{"id":"/docs/deep-exploration/structured-development-workflow-domain-329","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#8-observations-and-maintenance-notes","content":"**UI components are not yet consumed.** `ui/components/*` export reusable renderers, but `milestone/page.ts` and `workflow/page.ts` inline equivalent markup with their own `esc()` helpers (which, unlike the components, do not escape single quotes — relevant because commands are injected into `onclick=\"copyToClipboard('…')\"` attributes)."},"3267":{"id":"/docs/deep-exploration/structured-development-workflow-domain-330","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#8-observations-and-maintenance-notes","content":"**`package.json` `files` for kanboard** lists `tui/**/*.ts`, but no `tui/` directory exists in the package."},"3268":{"id":"/docs/deep-exploration/structured-development-workflow-domain-331","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#8-observations-and-maintenance-notes","content":"**Sandbox restrictions are partly advisory.** For `brainstorm` the write-path restriction to `.unipi/docs/specs/` and for `review` all constraints are expressed only as instructions in the snapshot/skill; the enforceable part is limited to blocked tool *names*."},"3269":{"id":"/docs/deep-exploration/structured-development-workflow-domain-332","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#commands","content":"Command"},"3270":{"id":"/docs/deep-exploration/structured-development-workflow-domain-333","page_id":"/docs/deep-exploration/structured-development-workflow-domain","tags":[],"type":"text","url":"/docs/deep-exploration/structured-development-workflow-domain#commands","content":"Package"},"3271"