ldren."},"996":{"id":"/docs/boundary-interfaces-98","page_id":"/docs/boundary-interfaces","tags":[],"type":"text","url":"/docs/boundary-interfaces#agent-tool-spawn_helper","content":"**Source File**: `./packages/subagents/src/index.ts, ./packages/subagents/src/tool-handler.ts`"},"997":{"id":"/docs/boundary-interfaces-99","page_id":"/docs/boundary-interfaces","tags":[],"type":"text","url":"/docs/boundary-interfaces#agent-tool-spawn_helper","content":"**Arguments**:"},"998":{"id":"/docs/boundary-interfaces-100","page_id":"/docs/boundary-interfaces","tags":[],"type":"text","url":"/docs/boundary-interfaces#agent-tool-spawn_helper","content":"`agent` (string): optional - Agent name or alias to spawn (resolved against built-in and custom agents)."},"999":{"id":"/docs/boundary-interfaces-101","page_id":"/docs/boundary-interfaces","tags":[],"type":"text","url":"/docs/boundary-interfaces#agent-tool-spawn_helper","content":"`task / prompt` (string): optional - Task description handed to the child agent."},"1000":{"id":"/docs/boundary-interfaces-102","page_id":"/docs/boundary-interfaces","tags":[],"type":"text","url":"/docs/boundary-interfaces#agent-tool-spawn_helper","content":"`workflowScript` (object): optional - Multi-step workflow script executed by the workflow runtime."},"1001":{"id":"/docs/boundary-interfaces-103","page_id":"/docs/boundary-interfaces","tags":[],"type":"text","url":"/docs/boundary-interfaces#agent-tool-spawn_helper","content":"`action` (string): optional - Management action (list, status, abort, etc.)."},"1002":{"id":"/docs/boundary-interfaces-104","page_id":"/docs/boundary-interfaces","tags":[],"type":"text","url":"/docs/boundary-interfaces#agent-tool-spawn_helper","content":"**Options**:"},"1003":{"id":"/docs/boundary-interfaces-105","page_id":"/docs/boundary-interfaces","tags":[],"type":"text","url":"/docs/boundary-interfaces#agent-tool-spawn_helper","content":"`timeout`(number): optional - Per-child timeout; defaults applied from config. (default: `