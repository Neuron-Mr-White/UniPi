{
  "name": "@pi-unipi/unipi",
  "version": "3.0.0-alpha.0",
  "description": "All-in-one extension suite for Pi coding agent",
  "type": "module",
  "license": "MIT",
  "author": "Neuron Mr White",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neuron-Mr-White/unipi.git"
  },
  "homepage": "https://github.com/Neuron-Mr-White/unipi#readme",
  "bugs": {
    "url": "https://github.com/Neuron-Mr-White/unipi/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "unipi"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-bundle.mjs",
    "prepare": "node scripts/build-bundle.mjs --if-missing",
    "prepublishOnly": "npm run build",
    "publish:all": "npm publish --workspaces --access public",
    "test": "npx tsx --test tests/*.test.js packages/memory/tests/*.test.ts && npm test --workspaces --if-present",
    "typecheck": "npx tsc --noEmit --skipLibCheck",
    "publish:kanboard": "node scripts/publish-kanboard-platforms.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "docs/prefix-cache-architecture.md",
    "packages/*/package.json",
    "packages/*/*.ts",
    "packages/*/tests/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.json",
    "packages/*/extensions/**/*.ts",
    "packages/*/bridge/**/*.py",
    "packages/*/platforms/*",
    "packages/*/tui/*",
    "packages/*/SKILL.md",
    "packages/*/skills/**/*",
    "packages/*/README.md",
    "packages/unipi/bundled.js",
    "packages/*/agents/*.md",
    "packages/*/prompts/*.md",
    "!packages/**/__tests__/**",
    "!packages/**/tests/**",
    "!packages/**/*.test.ts",
    "!packages/**/*.spec.ts"
  ],
  "pi": {
    "extensions": [
      "packages/unipi/bundled.js"
    ],
    "skills": [
      "packages/skill-registry/skills",
      "packages/memory/skills",
      "packages/btw/skills",
      "packages/ask-user/skills",
      "packages/mcp/skills",
      "packages/utility/skills",
      "packages/compactor/skills",
      "packages/notify/skills",
      "packages/kanboard/skills",
      "packages/updater/skills",
      "packages/image/skills",
      "packages/subagents/skills"
    ],
    "prompts": [
      "packages/subagents/prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.86.0",
    "@earendil-works/pi-coding-agent": "^0.86.0",
    "@earendil-works/pi-tui": "^0.86.0",
    "typebox": "^1.1.38"
  },
  "dependencies": {
    "@pi-unipi/ask-user": "3.0.0-alpha.0",
    "@pi-unipi/background-tasks": "3.0.0-alpha.0",
    "@pi-unipi/btw": "3.0.0-alpha.0",
    "@pi-unipi/command-enchantment": "3.0.0-alpha.0",
    "@pi-unipi/compactor": "3.0.0-alpha.0",
    "@pi-unipi/core": "3.0.0-alpha.0",
    "@pi-unipi/footer": "3.0.0-alpha.0",
    "@pi-unipi/image": "3.0.0-alpha.0",
    "@pi-unipi/fusion": "3.0.0-alpha.0",
    "@pi-unipi/info-screen": "3.0.0-alpha.0",
    "@pi-unipi/input-shortcuts": "3.0.0-alpha.0",
    "@pi-unipi/kanboard": "3.0.0-alpha.0",
    "@pi-unipi/mcp": "3.0.0-alpha.0",
    "@pi-unipi/memory": "3.0.0-alpha.0",
    "@pi-unipi/notify": "3.0.0-alpha.0",
    "@pi-unipi/skill-registry": "3.0.0-alpha.0",
    "@pi-unipi/subagents": "3.0.0-alpha.0",
    "@pi-unipi/updater": "3.0.0-alpha.0",
    "@pi-unipi/utility": "3.0.0-alpha.0",
    "@pi-unipi/web-api": "3.0.0-alpha.0",
    "@pi-unipi/workflow": "3.0.0-alpha.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.86.0",
    "@earendil-works/pi-ai": "^0.86.0",
    "@earendil-works/pi-coding-agent": "^0.86.0",
    "@earendil-works/pi-tui": "^0.86.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.6.0",
    "diff": "^7.0.0",
    "esbuild": "^0.27.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0"
  }
}
