{
  "name": "@pi-unipi/unipi",
  "version": "2.6.1",
  "description": "All-in-one extension suite for Pi coding agent",
  "type": "module",
  "license": "MIT",
  "author": "Neuron Mr White",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neuron-Mr-White/unipi.git"
  },
  "homepage": "https://github.com/Neuron-Mr-White/unipi#readme",
  "bugs": {
    "url": "https://github.com/Neuron-Mr-White/unipi/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "unipi"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-bundle.mjs",
    "prepare": "node scripts/build-bundle.mjs --if-missing",
    "prepublishOnly": "npm run build",
    "publish:all": "npm publish --workspaces --access public",
    "test": "npx tsx --test tests/*.test.js packages/memory/tests/*.test.ts && npm test --workspaces --if-present",
    "typecheck": "npx tsc --noEmit --skipLibCheck"
  },
  "files": [
    "CHANGELOG.md",
    "docs/prefix-cache-architecture.md",
    "packages/*/package.json",
    "packages/*/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/extensions/**/*.ts",
    "packages/*/bridge/**/*.py",
    "packages/*/platforms/*",
    "packages/*/tui/*",
    "packages/*/SKILL.md",
    "packages/*/skills/**/*",
    "packages/*/README.md",
    "packages/unipi/bundled.js",
    "!packages/**/__tests__/**",
    "!packages/**/tests/**",
    "!packages/**/*.test.ts",
    "!packages/**/*.spec.ts"
  ],
  "pi": {
    "extensions": [
      "packages/unipi/bundled.js"
    ],
    "skills": [
      "packages/workflow/skills",
      "packages/ralph/SKILL.md",
      "packages/memory/skills",
      "packages/btw/skills",
      "packages/ask-user/skills",
      "packages/mcp/skills",
      "packages/utility/skills",
      "packages/compactor/skills",
      "packages/notify/skills",
      "packages/milestone/skills",
      "packages/kanboard/skills",
      "packages/updater/skills",
      "packages/image/skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.80.0",
    "@earendil-works/pi-coding-agent": "^0.80.0",
    "@earendil-works/pi-tui": "^0.80.0",
    "typebox": "^1.1.38"
  },
  "dependencies": {
    "@pi-unipi/ask-user": "2.6.1",
    "@pi-unipi/btw": "2.6.1",
    "@pi-unipi/compactor": "2.6.1",
    "@pi-unipi/notify": "2.6.1",
    "@pi-unipi/command-enchantment": "2.6.1",
    "@pi-unipi/core": "2.6.1",
    "@pi-unipi/info-screen": "2.6.1",
    "@pi-unipi/mcp": "2.6.1",
    "@pi-unipi/memory": "2.6.1",
    "@pi-unipi/ralph": "2.6.1",
    "@pi-unipi/subagents": "2.6.1",
    "@pi-unipi/utility": "2.6.1",
    "@pi-unipi/milestone": "2.6.1",
    "@pi-unipi/kanboard": "2.6.1",
    "@pi-unipi/web-api": "2.6.1",
    "@pi-unipi/workflow": "2.6.1",
    "@pi-unipi/footer": "2.6.1",
    "@pi-unipi/updater": "2.6.1",
    "@pi-unipi/input-shortcuts": "2.6.1",
    "@pi-unipi/cocoindex": "2.6.1"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.80.0",
    "@earendil-works/pi-ai": "^0.80.0",
    "@earendil-works/pi-coding-agent": "^0.80.0",
    "@earendil-works/pi-tui": "^0.80.0",
    "@types/node": "^25.6.0",
    "diff": "^7.0.0",
    "esbuild": "^0.27.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0"
  }
}
