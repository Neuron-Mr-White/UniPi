{
  "name": "@pi-unipi/kanboard",
  "version": "3.0.0-alpha.27",
  "description": "Kanboard v3 — deferred-work board: CLI/daemon bridge, task runner and skill",
  "type": "module",
  "main": "index.ts",
  "license": "MIT",
  "author": "Neuron Mr White",
  "scripts": {
    "test": "UNIPI_FUSION_CHILD= UNIPI_SUBAGENT_CHILD= UNIPI_KANBOARD_CHILD= npx tsx --test tests/*.test.ts tests/*/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neuron-Mr-White/unipi.git",
    "directory": "packages/kanboard"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "unipi",
    "kanboard",
    "tasks"
  ],
  "files": [
    "index.ts",
    "src/**/*.ts",
    "skills/**/*.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pi-unipi/core": "3.0.0-alpha.27"
  },
