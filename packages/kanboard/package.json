  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [],
    "themes": []
  },
  "optionalDependencies": {
    "@pi-unipi/kanboard-linux-x64": "3.0.0-alpha.27",
    "@pi-unipi/kanboard-linux-arm64": "3.0.0-alpha.27",
    "@pi-unipi/kanboard-darwin-x64": "3.0.0-alpha.27",
    "@pi-unipi/kanboard-darwin-arm64": "3.0.0-alpha.27",
    "@pi-unipi/kanboard-win32-x64": "3.0.0-alpha.27"
  }
